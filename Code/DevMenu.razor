@using Sandbox;
@using Sandbox.UI;
@inherits PanelComponent

<root class=@(Open ? "open" : "closed")>
	@if ( !Open && DevFlags.Placing )
	{
		<div class="place-hint">Placing @placeKind: left click to place, right click to stop</div>
	}
	@if ( Open )
	{
		<div class="backdrop"></div>
		<div class="window">
			<div class="header">
				<div class="title">DEV MENU</div>
				<div class="hint">P to close</div>
			</div>

			<div class="body">
				<div class="section">
					<div class="heading">Spawning</div>
					<div class="chips">
						<div class=@Chip( !Paused ) onclick=@(() => Pause( !Paused ))>Spawning: @(Paused ? "PAUSED" : "ON")</div>
						<div class=@Chip( Zombies ) onclick=@(() => ToggleZombies())>Zombies</div>
						<div class=@Chip( Bloobers ) onclick=@(() => ToggleBloobers())>Bloobers</div>
						<div class=@Chip( Squiliens ) onclick=@(() => ToggleSquiliens())>Squiliens</div>
						<div class=@Chip( Crabs ) onclick=@(() => ToggleCrabs())>Junk Crabs</div>
						<div class=@Chip( BossWaves ) onclick=@(() => ToggleBossWaves())>Boss waves</div>
					</div>
					<div class="chips">
						<div class="chip action" onclick=@(() => KillAll())>Kill all enemies</div>
						<div class="chip action" onclick=@(() => SkipWave())>Skip wave</div>
					</div>
				</div>

				<div class="section">
					<div class="heading">Spawn one</div>
					<div class="chips">
						<div class="chip action" onclick=@(() => SpawnOne( WaveDirector.EnemyKind.Zombie ))>Zombie</div>
						<div class="chip action" onclick=@(() => SpawnOne( WaveDirector.EnemyKind.Bloober ))>Bloober</div>
						<div class="chip action" onclick=@(() => SpawnOne( WaveDirector.EnemyKind.Squilien ))>Squilien</div>
						<div class="chip action" onclick=@(() => SpawnOne( WaveDirector.EnemyKind.Crab ))>Junk Crab</div>
						<div class="chip action" onclick=@(() => SpawnOne( WaveDirector.EnemyKind.Boss ))>MC61 boss</div>
					</div>
				</div>

				<div class="section">
					<div class="heading">Place at crosshair (left click places, right click stops)</div>
					<div class="chips">
						<div class="chip action" onclick=@(() => StartPlacing( WaveDirector.EnemyKind.Zombie ))>Zombie</div>
						<div class="chip action" onclick=@(() => StartPlacing( WaveDirector.EnemyKind.Bloober ))>Bloober</div>
						<div class="chip action" onclick=@(() => StartPlacing( WaveDirector.EnemyKind.Squilien ))>Squilien</div>
						<div class="chip action" onclick=@(() => StartPlacing( WaveDirector.EnemyKind.Crab ))>Junk Crab</div>
						<div class="chip action" onclick=@(() => StartPlacing( WaveDirector.EnemyKind.Boss ))>MC61 boss</div>
					</div>
				</div>

				<div class="section">
					<div class="heading">Screenshots</div>
					<div class="chips">
						<div class=@Chip( DevFlags.FreezeEnemies ) onclick=@(() => DevFlags.FreezeEnemies = !DevFlags.FreezeEnemies)>Freeze enemies</div>
						<div class=@Chip( DevFlags.Noclip ) onclick=@(() => SetNoclip( !DevFlags.Noclip ))>Noclip</div>
						<div class=@Chip( DevFlags.HideHud ) onclick=@(() => DevFlags.HideHud = !DevFlags.HideHud)>Hide HUD</div>
						<div class=@Chip( DevFlags.HideWeapon ) onclick=@(() => DevFlags.HideWeapon = !DevFlags.HideWeapon)>Hide weapon</div>
					</div>
				</div>

				<div class="section">
					<div class="heading">Player</div>
					<div class="chips">
						<div class=@Chip( GodMode ) onclick=@(() => ToggleGodMode())>God mode</div>
						<div class=@Chip( InfiniteAmmo ) onclick=@(() => ToggleInfiniteAmmo())>Infinite ammo</div>
						<div class="chip action" onclick=@(() => Heal())>Heal</div>
						<div class="chip action" onclick=@(() => RefillAmmo())>Refill ammo</div>
						<div class="chip action" onclick=@(() => AddPoints())>+1000 points</div>
					</div>
				</div>

				<div class="section">
					<div class="heading">State</div>
					<div class="info">
						<span>Wave <b>@Wave</b></span>
						<span>Kills <b>@Kills</b></span>
						<span>Enemies left <b>@Remaining</b></span>
						<span>Phase <b>@Phase</b></span>
					</div>
				</div>
			</div>
		</div>
	}
</root>

@code {
	bool open;

	public bool Open => open;

	WaveDirector Director => Scene.GetAllComponents<WaveDirector>().FirstOrDefault();
	PlayerSurvivor Player => Scene.GetAllComponents<PlayerSurvivor>().FirstOrDefault( p => !p.IsProxy );

	protected override void OnStart()
	{
		DevFlags.Reset();   // the switches are static: start every play session clean
	}

	protected override void OnDestroy()
	{
		DevFlags.Reset();
	}

	protected override void OnUpdate()
	{
		// Dev tool: only in the editor, never in a published build.
		if ( !Game.IsEditor ) return;
		if ( Input.Pressed( "DevMenu" ) ) SetOpen( !open );
		UpdateNoclip();
		UpdatePlacing();
		UpdateHideHud();
	}

	/// <summary> Open/close: free the cursor and stop the player fighting while it's up. </summary>
	public void SetOpen( bool value )
	{
		if ( open == value ) return;
		open = value;

		Mouse.Visibility = open ? MouseVisibility.Visible : MouseVisibility.Hidden;

		var controller = Player?.Controller;
		if ( !controller.IsValid() ) return;
		if ( open )
		{
			controller.UseInputControls = false;
			controller.UseLookControls = false;
		}
		else if ( Player.IsAlive )
		{
			controller.UseInputControls = !DevFlags.Noclip;
			controller.UseLookControls = true;
		}
	}

	// ---- current state (also what the chips show) ----
	bool Paused => Director is { SpawningPaused: true };
	bool Zombies => Director is null || Director.SpawnZombies;
	bool Bloobers => Director is null || Director.SpawnBloobers;
	bool Squiliens => Director is null || Director.SpawnSquiliens;
	bool Crabs => Director is null || Director.SpawnCrabs;
	bool BossWaves => Director is null || Director.SpawnBossWaves;

	int Wave => Director?.Wave ?? 0;
	int Kills => Director?.Kills ?? 0;
	int Remaining => Director?.ZombiesRemaining ?? 0;
	string Phase => Director?.State.ToString() ?? "-";

	bool GodMode => Player?.Health?.Invulnerable ?? false;
	bool InfiniteAmmo => PlayerWeapons().Any( w => w.InfiniteAmmo );

	IEnumerable<PlayerWeapon> PlayerWeapons() =>
		Player?.Components.GetAll<PlayerWeapon>( FindMode.EverythingInSelf ) ?? System.Linq.Enumerable.Empty<PlayerWeapon>();

	// ---- actions ----
	void Pause( bool value ) { if ( Director is { } d ) d.SpawningPaused = value; }
	void ToggleZombies() { if ( Director is { } d ) d.SpawnZombies = !d.SpawnZombies; }
	void ToggleBloobers() { if ( Director is { } d ) d.SpawnBloobers = !d.SpawnBloobers; }
	void ToggleSquiliens() { if ( Director is { } d ) d.SpawnSquiliens = !d.SpawnSquiliens; }
	void ToggleCrabs() { if ( Director is { } d ) d.SpawnCrabs = !d.SpawnCrabs; }
	void ToggleBossWaves() { if ( Director is { } d ) d.SpawnBossWaves = !d.SpawnBossWaves; }
	void SpawnOne( WaveDirector.EnemyKind kind ) { Director?.Spawn( kind ); }
	void KillAll() { Director?.ClearEnemies(); }
	void SkipWave() { Director?.SkipWave(); }

	void ToggleGodMode() { if ( Player?.Health is { } h ) h.Invulnerable = !h.Invulnerable; }
	void ToggleInfiniteAmmo()
	{
		var on = !InfiniteAmmo;
		foreach ( var weapon in PlayerWeapons() ) weapon.InfiniteAmmo = on;
	}
	void Heal() { if ( Player?.Health is { } h ) h.Heal( h.MaxHealth ); }
	void RefillAmmo() { foreach ( var weapon in PlayerWeapons() ) weapon.RefillAmmo(); }
	void AddPoints() { Player?.AddPoints( 1000 ); }

	string Chip( bool on ) => on ? "chip on" : "chip off";

	// Re-render only when something the menu shows actually changes.
	protected override int BuildHash()
	{
		var a = System.HashCode.Combine( open, Wave, Kills, Remaining, Phase, GodMode, InfiniteAmmo, Paused );
		var b = System.HashCode.Combine( Zombies, Bloobers, Squiliens, Crabs, BossWaves,
			System.HashCode.Combine( DevFlags.FreezeEnemies, DevFlags.Noclip, DevFlags.HideHud, DevFlags.HideWeapon, DevFlags.Placing, placeKind ) );
		return System.HashCode.Combine( a, b );
	}

	// ---- hands-on tools: noclip, placing enemies at the crosshair, hiding the HUD ----
	WaveDirector.EnemyKind placeKind;
	bool noclipApplied;
	bool savedGravity = true;
	bool hudHidden;

	/// <summary> How fast noclip flies (Shift for 3x). </summary>
	const float NoclipSpeed = 450f;

	void SetNoclip( bool on )
	{
		DevFlags.Noclip = on;
		if ( Player?.Controller is { } controller && controller.IsValid() && !open )
			controller.UseInputControls = !on;
	}

	void UpdateNoclip()
	{
		var controller = Player?.Controller;
		if ( !controller.IsValid() ) return;
		var body = controller.Body;

		if ( DevFlags.Noclip != noclipApplied )
		{
			noclipApplied = DevFlags.Noclip;
			if ( body.IsValid() )
			{
				if ( noclipApplied )
				{
					savedGravity = body.Gravity;
					body.Gravity = false;
					body.Velocity = Vector3.Zero;
				}
				else
				{
					body.Gravity = savedGravity;
					body.Velocity = Vector3.Zero;
				}
				body.MotionEnabled = !noclipApplied;   // kinematic while flying, so walls don't push back
			}
			if ( !open ) controller.UseInputControls = !noclipApplied;
		}

		if ( !noclipApplied || open ) return;

		// Fly where you look: WASD along the view, Space up, Ctrl down, Shift faster.
		var view = controller.EyeAngles.ToRotation();
		var move = Input.AnalogMove;
		var wish = view.Forward * move.x + view.Left * move.y;
		if ( Input.Down( "Jump" ) ) wish += Vector3.Up;
		if ( Input.Down( "Duck" ) ) wish += Vector3.Down;
		if ( wish.IsNearlyZero() ) return;
		var speed = NoclipSpeed * (Input.Down( "Run" ) ? 3f : 1f);
		controller.WorldPosition += wish.Normal * speed * RealTime.Delta;
		if ( body.IsValid() ) body.Velocity = Vector3.Zero;
	}

	void StartPlacing( WaveDirector.EnemyKind kind )
	{
		placeKind = kind;
		DevFlags.Placing = true;
		SetOpen( false );
	}

	void UpdatePlacing()
	{
		if ( !DevFlags.Placing || open ) return;
		var camera = Scene.Camera;
		if ( !camera.IsValid() ) return;

		if ( Input.Pressed( "Attack2" ) )
		{
			DevFlags.Placing = false;
			return;
		}

		var from = camera.WorldPosition;
		var trace = Scene.Trace.Ray( from, from + camera.WorldRotation.Forward * 8000f )
			.WithoutTags( "player", "viewmodel", "creature", "gib", "zombie", "zombieblocker", "trigger" );
		if ( Player is { } p ) trace = trace.IgnoreGameObjectHierarchy( p.GameObject );
		var tr = trace.Run();
		if ( !tr.Hit ) return;

		DebugOverlay.Sphere( new Sphere( tr.HitPosition, 10f ), Color.Cyan );
		DebugOverlay.Line( tr.HitPosition, tr.HitPosition + Vector3.Up * 60f, Color.Cyan );

		if ( Input.Pressed( "Attack1" ) )
			Director?.SpawnAt( placeKind, tr.HitPosition + tr.Normal * 2f, from );
	}

	void UpdateHideHud()
	{
		var hide = DevFlags.HideHud;
		if ( hide == hudHidden ) return;
		hudHidden = hide;
		foreach ( var panel in Scene.GetAllComponents<PanelComponent>() )
		{
			if ( panel == this || panel.Panel is null ) continue;
			panel.Panel.Style.Display = hide ? DisplayMode.None : null;
		}
	}
}
