@using Sandbox;
@using Sandbox.UI;
@inherits PanelComponent

<root class=@(Open ? "open" : "closed")>
	@if ( DevFlags.ShowStats )
	{
		<div class="stats">
			<span>@Fps fps (@FrameMs ms)</span>
			<span>enemies @AliveEnemies</span>
			<span>time @(TimeScale)x</span>
			<span>@PlayerPos</span>
		</div>
	}
	@if ( !Open && DevFlags.FreeCam && !DevFlags.HideHud )
	{
		<div class="place-hint">Free camera: WASD, Space up, Ctrl down, Shift fast (turn it off in the menu)</div>
	}
	@if ( !Open && DevFlags.Placing )
	{
		<div class="place-hint">Placing @placeKind: left click to place, right click to stop</div>
	}
	@if ( Open )
	{
		<div class="backdrop"></div>
		<div class="window">
			<div class="header">
				<div class="title">DEV MENU</div>
				<div class="search-box">
					<TextEntry @ref="searchEntry" class="search" Value:bind=@search Placeholder="Search... (god, boss, skin, time)"></TextEntry>
					@if ( Searching )
					{
						<div class="clear" onclick=@(() => search = "")>x</div>
					}
				</div>
				<div class="header-right">
					<div class="hint">P to close</div>
					<div class="close" onclick=@(() => SetOpen( false ))>X</div>
				</div>
			</div>

			<div class="tabs @(Searching ? "searching" : "")">
				@foreach ( var t in Tabs )
				{
					<div class="tab @(tab == t && !Searching ? "active" : "")" onclick=@(() => { tab = t; search = ""; })>@t</div>
				}
				@if ( Searching )
				{
					<div class="tab-note">Showing matches from every tab</div>
				}
			</div>

			<div class="body">
				@{ sectionsShown = 0; }
				@* ================================================================ ENEMIES *@
				@if ( Sec( "Enemies", "Wave spawning", "spawning pause zombies bloobers squiliens junk crabs sea spiders boss waves kill all enemies skip wave" ) )
				{
					<div class="section">
						<div class="heading">Wave spawning</div>
						<div class="chips">
							@if ( Show( "Wave spawning", "spawning pause" ) ) { <div class=@Chip( !Paused ) onclick=@(() => Pause( !Paused ))>Spawning: @(Paused ? "PAUSED" : "ON")</div> }
							@if ( Show( "Wave spawning", "zombies" ) ) { <div class=@Chip( Zombies ) onclick=@(() => ToggleZombies())>Zombies</div> }
							@if ( Show( "Wave spawning", "bloobers" ) ) { <div class=@Chip( Bloobers ) onclick=@(() => ToggleBloobers())>Bloobers</div> }
							@if ( Show( "Wave spawning", "squiliens" ) ) { <div class=@Chip( Squiliens ) onclick=@(() => ToggleSquiliens())>Squiliens</div> }
							@if ( Show( "Wave spawning", "junk crabs" ) ) { <div class=@Chip( Crabs ) onclick=@(() => ToggleCrabs())>Junk Crabs</div> }
							@if ( Show( "Wave spawning", "sea spiders" ) ) { <div class=@Chip( Spiders ) onclick=@(() => ToggleSpiders())>Sea Spiders</div> }
							@if ( Show( "Wave spawning", "boss waves mc61" ) ) { <div class=@Chip( BossWaves ) onclick=@(() => ToggleBossWaves())>Boss waves</div> }
						</div>
						<div class="chips">
							@if ( Show( "Wave spawning", "kill all enemies clear" ) ) { <div class="chip action" onclick=@(() => KillAll())>Kill all enemies</div> }
							@if ( Show( "Wave spawning", "skip wave" ) ) { <div class="chip action" onclick=@(() => SkipWave())>Skip wave</div> }
						</div>
					</div>
				}

				@if ( Sec( "Enemies", "Spawn an enemy", string.Join( " ", EnemyKinds.Select( k => k.Name ) ) + " spawn place crosshair" ) )
				{
					<div class="section">
						<div class="heading">Spawn an enemy</div>
						<div class="spawn-grid">
							@foreach ( var k in EnemyKinds )
							{
								@if ( Show( "Spawn an enemy", k.Name + " spawn place crosshair" ) )
								{
									<div class="spawn-row">
										<div class="row-label wide">@k.Name</div>
										<div class="chip action" onclick=@(() => SpawnOne( k.Kind ))>Spawn</div>
										<div class="chip action" onclick=@(() => StartPlacing( k.Kind ))>Place at crosshair</div>
									</div>
								}
							}
						</div>
					</div>
				}

				@if ( Sec( "Enemies", "Allies", "ally spider spawn despawn allies friendly" ) )
				{
					<div class="section">
						<div class="heading">Allies</div>
						<div class="chips">
							<div class="chip action" onclick=@(() => SpawnAlly())>Spawn ally spider</div>
							<div class="chip action" onclick=@(() => DespawnAllies())>Despawn allies</div>
						</div>
					</div>
				}

				@if ( Sec( "Enemies", "Enemy debug", "freeze enemies one-shot kills show hitboxes" ) )
				{
					<div class="section">
						<div class="heading">Enemy debug</div>
						<div class="chips">
							@if ( Show( "Enemy debug", "freeze enemies" ) ) { <div class=@Chip( DevFlags.FreezeEnemies ) onclick=@(() => DevFlags.FreezeEnemies = !DevFlags.FreezeEnemies)>Freeze enemies</div> }
							@if ( Show( "Enemy debug", "one-shot kills" ) ) { <div class=@Chip( DevFlags.OneShot ) onclick=@(() => DevFlags.OneShot = !DevFlags.OneShot)>One-shot kills</div> }
							@if ( Show( "Enemy debug", "show hitboxes" ) ) { <div class=@Chip( DevFlags.ShowHitboxes ) onclick=@(() => DevFlags.ShowHitboxes = !DevFlags.ShowHitboxes)>Show hitboxes</div> }
						</div>
					</div>
				}

				@if ( Sec( "Enemies", "MC61 boss", "boss mc61 float charge beam cards dance 10% hp teleport" ) )
				{
					<div class="section">
						<div class="heading">MC61 boss</div>
						<div class="chips">
							<div class="row-label wide">Force move</div>
							<div class="chip action" onclick=@(() => ForceBoss( MC61.Mode.Float ))>Float</div>
							<div class="chip action" onclick=@(() => ForceBoss( MC61.Mode.Charge ))>Charge</div>
							<div class="chip action" onclick=@(() => ForceBoss( MC61.Mode.Beam ))>Beam</div>
							<div class="chip action" onclick=@(() => ForceBoss( MC61.Mode.Cards ))>Cards</div>
							<div class="chip action" onclick=@(() => ForceBoss( MC61.Mode.Dance ))>Dance</div>
						</div>
						<div class="chips">
							<div class="chip action" onclick=@(() => BossToTenPercent())>Boss to 10% HP</div>
							<div class="chip action" onclick=@(() => TeleportToBoss())>Teleport to MC61</div>
						</div>
					</div>
				}

				@* ================================================================ PLAYER *@
				@if ( Sec( "Player", "Cheats", "god mode infinite ammo heal refill ammo points money +1000" ) )
				{
					<div class="section">
						<div class="heading">Cheats</div>
						<div class="chips">
							@if ( Show( "Cheats", "god mode invulnerable" ) ) { <div class=@Chip( GodMode ) onclick=@(() => ToggleGodMode())>God mode</div> }
							@if ( Show( "Cheats", "infinite ammo" ) ) { <div class=@Chip( InfiniteAmmo ) onclick=@(() => ToggleInfiniteAmmo())>Infinite ammo</div> }
							@if ( Show( "Cheats", "heal health" ) ) { <div class="chip action" onclick=@(() => Heal())>Heal</div> }
							@if ( Show( "Cheats", "refill ammo" ) ) { <div class="chip action" onclick=@(() => RefillAmmo())>Refill ammo</div> }
							@if ( Show( "Cheats", "+1000 points money" ) ) { <div class="chip action" onclick=@(() => AddPoints())>+1000 points</div> }
						</div>
					</div>
				}

				@if ( Sec( "Player", "Appearance", "robot paint outfit skin gun skin weapon " + string.Join( " ", CharacterSkins.Names ) + " " + string.Join( " ", WeaponSkins.Names ) ) )
				{
					<div class="section">
						<div class="heading">Appearance</div>
						@if ( Show( "Appearance", "robot paint outfit " + string.Join( " ", CharacterSkins.Names ) ) )
						{
							<div class="chips">
								<div class="row-label wide">Robot paint</div>
								@foreach ( var outfit in CharacterSkins.Names )
								{
									<div class=@Pick( CharacterSkins.Current == outfit ) onclick=@(() => CharacterSkins.Current = outfit)>@outfit</div>
								}
							</div>
						}
						@if ( Show( "Appearance", "gun skin weapon " + string.Join( " ", WeaponSkins.Names ) ) )
						{
							<div class="chips">
								<div class="row-label wide">Gun skin</div>
								@foreach ( var skin in WeaponSkins.Names )
								{
									<div class=@Pick( WeaponSkins.Current == skin ) onclick=@(() => WeaponSkins.Current = skin)>@skin</div>
								}
							</div>
						}
					</div>
				}

				@if ( Sec( "Player", "Movement", "water feel swim underwater noclip fly" ) )
				{
					<div class="section">
						<div class="heading">Movement</div>
						@if ( Show( "Movement", "water feel swim underwater" ) )
						{
							<div class="chips">
								<div class="row-label wide">Water feel</div>
								<div class=@Pick( WaterFeel.Force == null ) onclick=@(() => WaterFeel.Force = null)>Auto</div>
								<div class=@Pick( WaterFeel.Force == true ) onclick=@(() => WaterFeel.Force = true)>On</div>
								<div class=@Pick( WaterFeel.Force == false ) onclick=@(() => WaterFeel.Force = false)>Off</div>
							</div>
						}
						@if ( Show( "Movement", "noclip fly" ) )
						{
							<div class="chips">
								<div class=@Chip( DevFlags.Noclip ) onclick=@(() => SetNoclip( !DevFlags.Noclip ))>Noclip</div>
							</div>
						}
					</div>
				}

				@* ================================================================ LOOK *@
				@if ( Sec( "Look", "Style", "look style shader post toon flat bands ink outline " + string.Join( " ", LookNames ) ) )
				{
					<div class="section">
						<div class="heading">Style</div>
						@if ( Show( "Style", "look style shader post toon flat " + string.Join( " ", LookNames ) ) )
						{
							<div class="chips">
								<div class="row-label wide">Look</div>
								@foreach ( var look in Enum.GetValues<GlobalStylize.Look>() )
								{
									<div class=@Pick( Stylize?.Style == look ) onclick=@(() => SetLook( look ))>@LookName( look )</div>
								}
							</div>
						}
						@if ( Show( "Style", "bands ink outline" ) )
						{
							<div class="chips">
								<div class="row-label wide">Bands</div>
								@foreach ( var n in BandCounts )
								{
									<div class=@Pick( Stylize is { } z && z.Bands == n ) onclick=@(() => { if ( Stylize is { } z2 ) z2.Bands = n; })>@n</div>
								}
							</div>
							<div class="chips">
								<div class="row-label wide">Ink</div>
								@foreach ( var o in InkLevels )
								{
									<div class=@Pick( Stylize is { } z && MathF.Abs( z.Outline - o ) < 0.01f ) onclick=@(() => { if ( Stylize is { } z2 ) z2.Outline = o; })>@(o == 0f ? "None" : $"{o}")</div>
								}
							</div>
						}
					</div>
				}

				@if ( Sec( "Look", "Lighting and effects", "sun lighting time of day morning noon dusk night skin effect dissolve ghost holo iridescent" ) )
				{
					<div class="section">
						<div class="heading">Lighting and effects</div>
						@if ( Show( "Lighting and effects", "sun lighting time of day " + string.Join( " ", SunPresets ) ) )
						{
							<div class="chips">
								<div class="row-label wide">Sun</div>
								@foreach ( var preset in SunPresets )
								{
									<div class=@Pick( sunPreset == preset ) onclick=@(() => SetSun( preset ))>@preset</div>
								}
							</div>
						}
						@if ( Show( "Lighting and effects", "skin effect creature " + string.Join( " ", SkinFx ) ) )
						{
							<div class="chips">
								<div class="row-label wide">Creature skin</div>
								@foreach ( var fx in SkinFx )
								{
									<div class=@Pick( skinFx == fx ) onclick=@(() => SetSkinFx( fx ))>@fx</div>
								}
							</div>
						}
					</div>
				}

				@if ( Sec( "Look", "Camera and screenshots", "camera fov free camera hide hud hide weapon screenshot" ) )
				{
					<div class="section">
						<div class="heading">Camera and screenshots</div>
						@if ( Show( "Camera and screenshots", "fov field of view" ) )
						{
							<div class="chips">
								<div class="row-label wide">FOV</div>
								@foreach ( var f in Fovs )
								{
									<div class=@Pick( DevFlags.Fov == f ) onclick=@(() => DevFlags.Fov = f)>@(f == 0f ? "Game" : $"{f}")</div>
								}
							</div>
						}
						<div class="chips">
							@if ( Show( "Camera and screenshots", "free camera" ) ) { <div class=@Chip( DevFlags.FreeCam ) onclick=@(() => SetFreeCam( !DevFlags.FreeCam ))>Free camera</div> }
							@if ( Show( "Camera and screenshots", "hide hud" ) ) { <div class=@Chip( DevFlags.HideHud ) onclick=@(() => DevFlags.HideHud = !DevFlags.HideHud)>Hide HUD</div> }
							@if ( Show( "Camera and screenshots", "hide weapon gun" ) ) { <div class=@Chip( DevFlags.HideWeapon ) onclick=@(() => DevFlags.HideWeapon = !DevFlags.HideWeapon)>Hide weapon</div> }
						</div>
					</div>
				}

				@* ================================================================ WORLD *@
				@if ( Sec( "World", "Waves", "wave next +5 boss wave state kills enemies left phase" ) )
				{
					<div class="section">
						<div class="heading">Waves</div>
						<div class="chips">
							<div class="chip action" onclick=@(() => Director?.JumpToWave( Wave + 1 ))>Next wave</div>
							<div class="chip action" onclick=@(() => Director?.JumpToWave( Wave + 5 ))>+5 waves</div>
							@if ( Director is { NextBossWave: > 0 } d )
							{
								<div class="chip action" onclick=@(() => d.JumpToWave( d.NextBossWave ))>Boss wave (@d.NextBossWave)</div>
							}
						</div>
						<div class="info">
							<span>Wave <b>@Wave</b></span>
							<span>Kills <b>@Kills</b></span>
							<span>Enemies left <b>@Remaining</b></span>
							<span>Phase <b>@Phase</b></span>
						</div>
					</div>
				}

				@if ( Sec( "World", "Time", "time scale slow motion stop pause speed" ) )
				{
					<div class="section">
						<div class="heading">Time</div>
						<div class="chips">
							@foreach ( var t in TimeScales )
							{
								<div class=@Pick( MathF.Abs( TimeScale - t ) < 0.01f ) onclick=@(() => SetTimeScale( t ))>@(t == 0f ? "Stop" : $"{t}x")</div>
							}
						</div>
					</div>
				}

				@if ( Sec( "World", "Travel", "travel teleport spawn point save spot go to saved scene level indoor forest water" ) )
				{
					<div class="section">
						<div class="heading">Travel</div>
						@if ( Show( "Travel", "teleport spawn point save spot go to saved" ) )
						{
							<div class="chips">
								<div class="chip action" onclick=@(() => TeleportToSpawnPoint())>To a spawn point</div>
								<div class="chip action" onclick=@(() => SaveSpot())>Save spot</div>
								<div class=@(savedSpot is null ? "chip off" : "chip action") onclick=@(() => LoadSpot())>Go to saved spot</div>
							</div>
						}
						@if ( Show( "Travel", "scene level load indoor forest water" ) )
						{
							<div class="chips">
								<div class="row-label wide">Scene</div>
								<div class="chip action" onclick=@(() => LoadScene( "scenes/indoor.scene" ))>Indoor</div>
								<div class="chip action" onclick=@(() => LoadScene( "scenes/forest.scene" ))>Forest</div>
								<div class="chip action" onclick=@(() => LoadScene( "scenes/water_level.scene" ))>Water level</div>
							</div>
						}
					</div>
				}

				@if ( Sec( "World", "Debug", "stats overlay fps performance" ) )
				{
					<div class="section">
						<div class="heading">Debug</div>
						<div class="chips">
							<div class=@Chip( DevFlags.ShowStats ) onclick=@(() => DevFlags.ShowStats = !DevFlags.ShowStats)>Stats overlay (fps)</div>
						</div>
					</div>
				}

				@if ( Searching && sectionsShown == 0 )
				{
					<div class="no-results">Nothing matches "@search"</div>
				}
			</div>
		</div>
	}
</root>

@code {
	bool open;

	public bool Open => open;

	WaveDirector Director => Scene.GetAllComponents<WaveDirector>().FirstOrDefault();
	PlayerSurvivor Player => Scene.GetAllComponents<PlayerSurvivor>().FirstOrDefault( p => !p.IsProxy );

	protected override void OnStart()
	{
		DevFlags.Reset();   // the switches are static: start every play session clean
		Scene.TimeScale = 1f;
	}

	protected override void OnDestroy()
	{
		DevFlags.Reset();
	}

	protected override void OnUpdate()
	{
		// Dev tool: only in the editor, never in a published build.
		if ( !Game.IsEditor ) return;
		// (not while typing in the search box: P is a letter there)
		if ( Input.Pressed( "DevMenu" ) && !(searchEntry?.HasFocus ?? false) ) SetOpen( !open );
		UpdateNoclip();
		UpdateFreeCam();
		UpdatePlacing();
		UpdateHideHud();
		UpdateHitboxes();
	}

	/// <summary> Open/close: free the cursor and stop the player fighting while it's up. </summary>
	public void SetOpen( bool value )
	{
		if ( open == value ) return;
		open = value;

		Mouse.Visibility = open ? MouseVisibility.Visible : MouseVisibility.Hidden;

		var controller = Player?.Controller;
		if ( !controller.IsValid() ) return;
		if ( open )
		{
			controller.UseInputControls = false;
			controller.UseLookControls = false;
		}
		else if ( Player.IsAlive )
		{
			controller.UseInputControls = !DevFlags.Noclip && !DevFlags.FreeCam;
			controller.UseLookControls = !DevFlags.FreeCam;
		}
	}

	// ---- current state (also what the chips show) ----
	bool Paused => Director is { SpawningPaused: true };
	bool Zombies => Director is null || Director.SpawnZombies;
	bool Bloobers => Director is null || Director.SpawnBloobers;
	bool Squiliens => Director is null || Director.SpawnSquiliens;
	bool Crabs => Director is null || Director.SpawnCrabs;
	bool Spiders => Director is null || Director.SpawnSpiders;
	bool BossWaves => Director is null || Director.SpawnBossWaves;

	int Wave => Director?.Wave ?? 0;
	int Kills => Director?.Kills ?? 0;
	int Remaining => Director?.ZombiesRemaining ?? 0;
	string Phase => Director?.State.ToString() ?? "-";

	bool GodMode => Player?.Health?.Invulnerable ?? false;
	bool InfiniteAmmo => PlayerWeapons().Any( w => w.InfiniteAmmo );

	IEnumerable<PlayerWeapon> PlayerWeapons() =>
		Player?.Components.GetAll<PlayerWeapon>( FindMode.EverythingInSelf ) ?? System.Linq.Enumerable.Empty<PlayerWeapon>();

	// ---- actions ----
	void Pause( bool value ) { if ( Director is { } d ) d.SpawningPaused = value; }
	void ToggleZombies() { if ( Director is { } d ) d.SpawnZombies = !d.SpawnZombies; }
	void ToggleBloobers() { if ( Director is { } d ) d.SpawnBloobers = !d.SpawnBloobers; }
	void ToggleSquiliens() { if ( Director is { } d ) d.SpawnSquiliens = !d.SpawnSquiliens; }
	void ToggleCrabs() { if ( Director is { } d ) d.SpawnCrabs = !d.SpawnCrabs; }
	/// <summary> Removes every ally and stops them coming back (spawning one again turns that back on). </summary>
	void DespawnAllies()
	{
		AllyCommander.KeepAlly = false;
		foreach ( var a in Scene.GetAllComponents<SeaSpider>().Where( s => s.IsAlly ).ToList() ) a.GameObject.Destroy();
	}

	void SpawnAlly()
	{
		AllyCommander.KeepAlly = true;
		foreach ( var a in Scene.GetAllComponents<SeaSpider>().Where( s => s.IsAlly ).ToList() ) a.GameObject.Destroy();
		if ( Player.IsValid() ) SeaSpider.SpawnAlly( Scene, Player );
	}
	void ToggleSpiders() { if ( Director is { } d ) d.SpawnSpiders = !d.SpawnSpiders; }
	void ToggleBossWaves() { if ( Director is { } d ) d.SpawnBossWaves = !d.SpawnBossWaves; }
	void SpawnOne( WaveDirector.EnemyKind kind ) { Director?.Spawn( kind ); }
	void KillAll() { Director?.ClearEnemies(); }
	void SkipWave() { Director?.SkipWave(); }

	void ToggleGodMode() { if ( Player?.Health is { } h ) h.Invulnerable = !h.Invulnerable; }
	void ToggleInfiniteAmmo()
	{
		var on = !InfiniteAmmo;
		foreach ( var weapon in PlayerWeapons() ) weapon.InfiniteAmmo = on;
	}
	void Heal() { if ( Player?.Health is { } h ) h.Heal( h.MaxHealth ); }
	void RefillAmmo() { foreach ( var weapon in PlayerWeapons() ) weapon.RefillAmmo(); }
	void AddPoints() { Player?.AddPoints( 1000 ); }

	// ---- tabs and search ----
	string search = "";
	string tab = "Enemies";
	TextEntry searchEntry;
	int sectionsShown;
	static readonly string[] Tabs = { "Enemies", "Player", "Look", "World" };
	bool Searching => !string.IsNullOrWhiteSpace( search );
	bool Has( string text ) => text.Contains( search.Trim(), StringComparison.OrdinalIgnoreCase );
	/// <summary> A section shows on its own tab, or, while searching, wherever its name or contents match. </summary>
	bool Sec( string tabName, string section, string keywords )
	{
		var show = Searching ? Has( section ) || Has( keywords ) : tab == tabName;
		if ( show ) sectionsShown++;
		return show;
	}
	/// <summary> One control inside a section: hidden while searching unless it (or its section) matches. </summary>
	bool Show( string section, string keywords ) => !Searching || Has( section ) || Has( keywords );

	readonly record struct EnemyEntry( string Name, WaveDirector.EnemyKind Kind );
	static readonly EnemyEntry[] EnemyKinds =
	{
		new( "Zombie", WaveDirector.EnemyKind.Zombie ),
		new( "Bloober", WaveDirector.EnemyKind.Bloober ),
		new( "Squilien", WaveDirector.EnemyKind.Squilien ),
		new( "Junk Crab", WaveDirector.EnemyKind.Crab ),
		new( "Sea Spider", WaveDirector.EnemyKind.Spider ),
		new( "MC61 boss", WaveDirector.EnemyKind.Boss ),
	};
	static string LookName( GlobalStylize.Look look ) => look switch
	{
		GlobalStylize.Look.InkOutlines => "Ink",
		GlobalStylize.Look.Painterly => "Paint",
		GlobalStylize.Look.Storybook => "Book",
		GlobalStylize.Look.Watercolor => "Water",
		_ => look.ToString(),
	};
	static IEnumerable<string> LookNames => Enum.GetValues<GlobalStylize.Look>().Select( LookName );

	string Chip( bool on ) => on ? "chip on" : "chip off";
	string Pick( bool on ) => on ? "chip on" : "chip";

	// Re-render only when something the menu shows actually changes.
	protected override int BuildHash()
	{
		var a = System.HashCode.Combine( open, Wave, Kills, Remaining, Phase, GodMode, InfiniteAmmo, Paused );
		var b = System.HashCode.Combine( Zombies, Bloobers, Squiliens, Crabs, Spiders, BossWaves,
			System.HashCode.Combine( DevFlags.FreezeEnemies, DevFlags.Noclip, DevFlags.HideHud, DevFlags.HideWeapon, DevFlags.Placing, placeKind ) );
		var c = System.HashCode.Combine( DevFlags.FreeCam, DevFlags.Fov, DevFlags.OneShot, DevFlags.ShowHitboxes, DevFlags.ShowStats, TimeScale, sunPreset, savedSpot is null );
		// The stats overlay ticks a few times a second.
		var d = DevFlags.ShowStats ? (int)(RealTime.Now * 4f) : 0;
		// While open it also redraws ten times a second, so every chip shows the current state (skins, looks...).
		var e = open ? (int)(RealTime.Now * 10f) : 0;
		return System.HashCode.Combine( a, b, c, d, e, search, tab );
	}

	// ---- hands-on tools: noclip, placing enemies at the crosshair, hiding the HUD ----
	WaveDirector.EnemyKind placeKind;
	bool noclipApplied;
	bool savedGravity = true;
	bool hudHidden;

	/// <summary> How fast noclip flies (Shift for 3x). </summary>
	const float NoclipSpeed = 450f;

	void SetNoclip( bool on )
	{
		DevFlags.Noclip = on;
		if ( Player?.Controller is { } controller && controller.IsValid() && !open )
			controller.UseInputControls = !on && !DevFlags.FreeCam;
	}

	void UpdateNoclip()
	{
		var controller = Player?.Controller;
		if ( !controller.IsValid() ) return;
		var body = controller.Body;

		if ( DevFlags.Noclip != noclipApplied )
		{
			noclipApplied = DevFlags.Noclip;
			if ( body.IsValid() )
			{
				if ( noclipApplied )
				{
					savedGravity = body.Gravity;
					body.Gravity = false;
					body.Velocity = Vector3.Zero;
				}
				else
				{
					body.Gravity = savedGravity;
					body.Velocity = Vector3.Zero;
				}
				body.MotionEnabled = !noclipApplied;   // kinematic while flying, so walls don't push back
			}
			if ( !open ) controller.UseInputControls = !noclipApplied && !DevFlags.FreeCam;
		}

		if ( !noclipApplied || open || DevFlags.FreeCam ) return;

		// Fly where you look: WASD along the view, Space up, Ctrl down, Shift faster.
		var view = controller.EyeAngles.ToRotation();
		var move = Input.AnalogMove;
		var wish = view.Forward * move.x + view.Left * move.y;
		if ( Input.Down( "Jump" ) ) wish += Vector3.Up;
		if ( Input.Down( "Duck" ) ) wish += Vector3.Down;
		if ( wish.IsNearlyZero() ) return;
		var speed = NoclipSpeed * (Input.Down( "Run" ) ? 3f : 1f);
		controller.WorldPosition += wish.Normal * speed * RealTime.Delta;
		if ( body.IsValid() ) body.Velocity = Vector3.Zero;
	}

	void StartPlacing( WaveDirector.EnemyKind kind )
	{
		placeKind = kind;
		DevFlags.Placing = true;
		SetOpen( false );
	}

	void UpdatePlacing()
	{
		if ( !DevFlags.Placing || open ) return;
		var camera = Scene.Camera;
		if ( !camera.IsValid() ) return;

		if ( Input.Pressed( "Attack2" ) )
		{
			DevFlags.Placing = false;
			return;
		}

		var from = camera.WorldPosition;
		var trace = Scene.Trace.Ray( from, from + camera.WorldRotation.Forward * 8000f )
			.WithoutTags( "player", "viewmodel", "creature", "gib", "zombie", "zombieblocker", "trigger" );
		if ( Player is { } p ) trace = trace.IgnoreGameObjectHierarchy( p.GameObject );
		var tr = trace.Run();
		if ( !tr.Hit ) return;

		DebugOverlay.Sphere( new Sphere( tr.HitPosition, 10f ), Color.Cyan );
		DebugOverlay.Line( tr.HitPosition, tr.HitPosition + Vector3.Up * 60f, Color.Cyan );

		if ( Input.Pressed( "Attack1" ) )
			Director?.SpawnAt( placeKind, tr.HitPosition + tr.Normal * 2f, from );
	}

	void UpdateHideHud()
	{
		var hide = DevFlags.HideHud;
		if ( hide == hudHidden ) return;
		hudHidden = hide;
		foreach ( var panel in Scene.GetAllComponents<PanelComponent>() )
		{
			if ( panel == this || panel.Panel is null ) continue;
			panel.Panel.Style.Display = hide ? DisplayMode.None : null;
		}
	}

	// ---- free camera: fly the view on its own while the player stays put ----
	const float FreeCamSpeed = 350f;

	void SetFreeCam( bool on )
	{
		var controller = Player?.Controller;
		if ( on )
		{
			var cam = Scene.Camera;
			DevFlags.FreeCamPosition = cam.IsValid() ? cam.WorldPosition : (controller?.WorldPosition ?? Vector3.Zero) + Vector3.Up * 64f;
			DevFlags.FreeCamAngles = controller.IsValid() ? controller.EyeAngles : (cam.IsValid() ? cam.WorldRotation.Angles() : Angles.Zero);
		}
		DevFlags.FreeCam = on;
		if ( controller.IsValid() && !open )
		{
			controller.UseInputControls = !on && !DevFlags.Noclip;
			controller.UseLookControls = !on;
		}
	}

	void UpdateFreeCam()
	{
		if ( !DevFlags.FreeCam || open ) return;
		var look = Input.AnalogLook;
		var angles = DevFlags.FreeCamAngles + look;
		angles.pitch = MathX.Clamp( angles.pitch, -89f, 89f );
		angles.roll = 0f;
		DevFlags.FreeCamAngles = angles;

		var view = angles.ToRotation();
		var move = Input.AnalogMove;
		var wish = view.Forward * move.x + view.Left * move.y;
		if ( Input.Down( "Jump" ) ) wish += Vector3.Up;
		if ( Input.Down( "Duck" ) ) wish += Vector3.Down;
		if ( wish.IsNearlyZero() ) return;
		var speed = FreeCamSpeed * (Input.Down( "Run" ) ? 3f : 1f);
		DevFlags.FreeCamPosition += wish.Normal * speed * RealTime.Delta;
	}

