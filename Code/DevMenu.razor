@using Sandbox;
@using Sandbox.UI;
@inherits PanelComponent

<root class=@(Open ? "open" : "closed")>
	@if ( DevFlags.ShowStats )
	{
		<div class="stats">
			<span>@Fps fps (@FrameMs ms)</span>
			<span>enemies @AliveEnemies</span>
			<span>time @(TimeScale)x</span>
			<span>@PlayerPos</span>
		</div>
	}
	@if ( !Open && DevFlags.FreeCam && !DevFlags.HideHud )
	{
		<div class="place-hint">Free camera: WASD, Space up, Ctrl down, Shift fast (turn it off in the menu)</div>
	}
	@if ( !Open && DevFlags.Placing )
	{
		<div class="place-hint">Placing @placeKind: left click to place, right click to stop</div>
	}
	@if ( Open )
	{
		<div class="backdrop"></div>
		<div class="window">
			<div class="header">
				<div class="title">DEV MENU</div>
				<div class="header-right">
					<div class="hint">P to close</div>
					<div class="close" onclick=@(() => SetOpen( false ))>X</div>
				</div>
			</div>

			<div class="body">
				<div class="column">
					<div class="section">
						<div class="heading">Spawning</div>
						<div class="chips">
							<div class=@Chip( !Paused ) onclick=@(() => Pause( !Paused ))>Spawning: @(Paused ? "PAUSED" : "ON")</div>
							<div class=@Chip( Zombies ) onclick=@(() => ToggleZombies())>Zombies</div>
							<div class=@Chip( Bloobers ) onclick=@(() => ToggleBloobers())>Bloobers</div>
							<div class=@Chip( Squiliens ) onclick=@(() => ToggleSquiliens())>Squiliens</div>
							<div class=@Chip( Crabs ) onclick=@(() => ToggleCrabs())>Junk Crabs</div>
							<div class=@Chip( Spiders ) onclick=@(() => ToggleSpiders())>Sea Spiders</div>
							<div class=@Chip( BossWaves ) onclick=@(() => ToggleBossWaves())>Boss waves</div>
						</div>
						<div class="chips">
							<div class="chip action" onclick=@(() => KillAll())>Kill all enemies</div>
							<div class="chip action" onclick=@(() => SkipWave())>Skip wave</div>
						</div>
					</div>

					<div class="section">
						<div class="heading">Spawn one</div>
						<div class="chips">
							<div class="chip action" onclick=@(() => SpawnOne( WaveDirector.EnemyKind.Zombie ))>Zombie</div>
							<div class="chip action" onclick=@(() => SpawnOne( WaveDirector.EnemyKind.Bloober ))>Bloober</div>
							<div class="chip action" onclick=@(() => SpawnOne( WaveDirector.EnemyKind.Squilien ))>Squilien</div>
							<div class="chip action" onclick=@(() => SpawnOne( WaveDirector.EnemyKind.Crab ))>Junk Crab</div>
							<div class="chip action" onclick=@(() => SpawnOne( WaveDirector.EnemyKind.Spider ))>Sea Spider</div>
							<div class="chip action" onclick=@(() => SpawnAlly())>Ally Spider</div>
							<div class="chip action" onclick=@(() => SpawnOne( WaveDirector.EnemyKind.Boss ))>MC61 boss</div>
						</div>
					</div>

					<div class="section">
						<div class="heading">Place at crosshair</div>
						<div class="chips">
							<div class="chip action" onclick=@(() => StartPlacing( WaveDirector.EnemyKind.Zombie ))>Zombie</div>
							<div class="chip action" onclick=@(() => StartPlacing( WaveDirector.EnemyKind.Bloober ))>Bloober</div>
							<div class="chip action" onclick=@(() => StartPlacing( WaveDirector.EnemyKind.Squilien ))>Squilien</div>
							<div class="chip action" onclick=@(() => StartPlacing( WaveDirector.EnemyKind.Crab ))>Junk Crab</div>
							<div class="chip action" onclick=@(() => StartPlacing( WaveDirector.EnemyKind.Spider ))>Sea Spider</div>
							<div class="chip action" onclick=@(() => StartPlacing( WaveDirector.EnemyKind.Boss ))>MC61 boss</div>
						</div>
					</div>

					<div class="section">
						<div class="heading">Enemies</div>
						<div class="chips">
							<div class=@Chip( DevFlags.FreezeEnemies ) onclick=@(() => DevFlags.FreezeEnemies = !DevFlags.FreezeEnemies)>Freeze enemies</div>
							<div class=@Chip( DevFlags.OneShot ) onclick=@(() => DevFlags.OneShot = !DevFlags.OneShot)>One-shot kills</div>
							<div class=@Chip( DevFlags.ShowHitboxes ) onclick=@(() => DevFlags.ShowHitboxes = !DevFlags.ShowHitboxes)>Show hitboxes</div>
						</div>
						<div class="chips">
							<div class="chip action" onclick=@(() => ForceBoss( MC61.Mode.Float ))>MC61 float</div>
							<div class="chip action" onclick=@(() => ForceBoss( MC61.Mode.Charge ))>Charge</div>
							<div class="chip action" onclick=@(() => ForceBoss( MC61.Mode.Beam ))>Beam</div>
							<div class="chip action" onclick=@(() => ForceBoss( MC61.Mode.Cards ))>Cards</div>
							<div class="chip action" onclick=@(() => ForceBoss( MC61.Mode.Dance ))>Dance</div>
							<div class="chip action" onclick=@(() => BossToTenPercent())>MC61 to 10% HP</div>
						</div>
					</div>

					<div class="section">
						<div class="heading">Player</div>
						<div class="chips">
							<div class=@Chip( GodMode ) onclick=@(() => ToggleGodMode())>God mode</div>
							<div class=@Chip( InfiniteAmmo ) onclick=@(() => ToggleInfiniteAmmo())>Infinite ammo</div>
							<div class="chip action" onclick=@(() => Heal())>Heal</div>
							<div class="chip action" onclick=@(() => RefillAmmo())>Refill ammo</div>
							<div class="chip action" onclick=@(() => AddPoints())>+1000 points</div>
						</div>
					</div>
				</div>

				<div class="column">
					<div class="section">
						<div class="heading">Screenshots</div>
						<div class="chips">
							<div class=@Chip( DevFlags.Noclip ) onclick=@(() => SetNoclip( !DevFlags.Noclip ))>Noclip</div>
							<div class=@Chip( DevFlags.FreeCam ) onclick=@(() => SetFreeCam( !DevFlags.FreeCam ))>Free camera</div>
							<div class=@Chip( DevFlags.HideHud ) onclick=@(() => DevFlags.HideHud = !DevFlags.HideHud)>Hide HUD</div>
							<div class=@Chip( DevFlags.HideWeapon ) onclick=@(() => DevFlags.HideWeapon = !DevFlags.HideWeapon)>Hide weapon</div>
						</div>
						<div class="chips">
							<div class="row-label">Time</div>
							@foreach ( var t in TimeScales )
							{
								<div class=@Pick( MathF.Abs( TimeScale - t ) < 0.01f ) onclick=@(() => SetTimeScale( t ))>@(t == 0f ? "Stop" : $"{t}x")</div>
							}
						</div>
						<div class="chips">
							<div class="row-label">FOV</div>
							@foreach ( var f in Fovs )
							{
								<div class=@Pick( DevFlags.Fov == f ) onclick=@(() => DevFlags.Fov = f)>@(f == 0f ? "Game" : $"{f}")</div>
							}
						</div>
						<div class="chips">
							<div class="row-label">Look</div>
							@foreach ( var look in Enum.GetValues<GlobalStylize.Look>() )
							{
								<div class=@Pick( Stylize?.Style == look ) onclick=@(() => SetLook( look ))>@(look switch { GlobalStylize.Look.InkOutlines => "Ink", GlobalStylize.Look.Painterly => "Paint", GlobalStylize.Look.Storybook => "Book", GlobalStylize.Look.Watercolor => "Water", _ => look.ToString() })</div>
							}
						</div>
						<div class="chips">
							<div class="row-label">Bands</div>
							@foreach ( var n in BandCounts )
							{
								<div class=@Pick( Stylize is { } z && z.Bands == n ) onclick=@(() => { if ( Stylize is { } z2 ) z2.Bands = n; })>@n</div>
							}
							<div class="row-label">Ink</div>
							@foreach ( var o in InkLevels )
							{
								<div class=@Pick( Stylize is { } z && MathF.Abs( z.Outline - o ) < 0.01f ) onclick=@(() => { if ( Stylize is { } z2 ) z2.Outline = o; })>@(o == 0f ? "None" : $"{o}")</div>
							}
						</div>
						<div class="chips">
							<div class="row-label">Skin</div>
							@foreach ( var fx in SkinFx )
							{
								<div class=@Pick( skinFx == fx ) onclick=@(() => SetSkinFx( fx ))>@fx</div>
							}
						</div>
						<div class="chips">
							<div class="row-label">Sun</div>
							@foreach ( var preset in SunPresets )
							{
								<div class=@Pick( sunPreset == preset ) onclick=@(() => SetSun( preset ))>@preset</div>
							}
						</div>
					</div>

					<div class="section">
						<div class="heading">Waves</div>
						<div class="chips">
							<div class="chip action" onclick=@(() => Director?.JumpToWave( Wave + 1 ))>Next wave</div>
							<div class="chip action" onclick=@(() => Director?.JumpToWave( Wave + 5 ))>+5 waves</div>
							@if ( Director is { NextBossWave: > 0 } d )
							{
								<div class="chip action" onclick=@(() => d.JumpToWave( d.NextBossWave ))>Boss wave (@d.NextBossWave)</div>
							}
						</div>
					</div>

					<div class="section">
						<div class="heading">Travel</div>
						<div class="chips">
							<div class="chip action" onclick=@(() => TeleportToBoss())>To MC61</div>
							<div class="chip action" onclick=@(() => TeleportToSpawnPoint())>To a spawn point</div>
							<div class="chip action" onclick=@(() => SaveSpot())>Save spot</div>
							<div class=@(savedSpot is null ? "chip off" : "chip action") onclick=@(() => LoadSpot())>Go to saved spot</div>
						</div>
						<div class="chips">
							<div class="row-label">Scene</div>
							<div class="chip action" onclick=@(() => LoadScene( "scenes/indoor.scene" ))>Indoor</div>
							<div class="chip action" onclick=@(() => LoadScene( "scenes/forest.scene" ))>Forest</div>
							<div class="chip action" onclick=@(() => LoadScene( "scenes/water_level.scene" ))>Water level</div>
						</div>
					</div>

					<div class="section">
						<div class="heading">State</div>
						<div class="chips">
							<div class=@Chip( DevFlags.ShowStats ) onclick=@(() => DevFlags.ShowStats = !DevFlags.ShowStats)>Stats overlay</div>
						</div>
						<div class="info">
							<span>Wave <b>@Wave</b></span>
							<span>Kills <b>@Kills</b></span>
							<span>Enemies left <b>@Remaining</b></span>
							<span>Phase <b>@Phase</b></span>
						</div>
					</div>
				</div>
			</div>
		</div>
	}
</root>

@code {
	bool open;

	public bool Open => open;

	WaveDirector Director => Scene.GetAllComponents<WaveDirector>().FirstOrDefault();
	PlayerSurvivor Player => Scene.GetAllComponents<PlayerSurvivor>().FirstOrDefault( p => !p.IsProxy );

	protected override void OnStart()
	{
		DevFlags.Reset();   // the switches are static: start every play session clean
		Scene.TimeScale = 1f;
	}

	protected override void OnDestroy()
	{
		DevFlags.Reset();
	}

	protected override void OnUpdate()
	{
		// Dev tool: only in the editor, never in a published build.
		if ( !Game.IsEditor ) return;
		if ( Input.Pressed( "DevMenu" ) ) SetOpen( !open );
		UpdateNoclip();
		UpdateFreeCam();
		UpdatePlacing();
		UpdateHideHud();
		UpdateHitboxes();
	}

	/// <summary> Open/close: free the cursor and stop the player fighting while it's up. </summary>
	public void SetOpen( bool value )
	{
		if ( open == value ) return;
		open = value;

		Mouse.Visibility = open ? MouseVisibility.Visible : MouseVisibility.Hidden;

		var controller = Player?.Controller;
		if ( !controller.IsValid() ) return;
		if ( open )
		{
			controller.UseInputControls = false;
			controller.UseLookControls = false;
		}
		else if ( Player.IsAlive )
		{
			controller.UseInputControls = !DevFlags.Noclip && !DevFlags.FreeCam;
			controller.UseLookControls = !DevFlags.FreeCam;
		}
	}

	// ---- current state (also what the chips show) ----
	bool Paused => Director is { SpawningPaused: true };
	bool Zombies => Director is null || Director.SpawnZombies;
	bool Bloobers => Director is null || Director.SpawnBloobers;
	bool Squiliens => Director is null || Director.SpawnSquiliens;
	bool Crabs => Director is null || Director.SpawnCrabs;
	bool Spiders => Director is null || Director.SpawnSpiders;
	bool BossWaves => Director is null || Director.SpawnBossWaves;

	int Wave => Director?.Wave ?? 0;
	int Kills => Director?.Kills ?? 0;
	int Remaining => Director?.ZombiesRemaining ?? 0;
	string Phase => Director?.State.ToString() ?? "-";

	bool GodMode => Player?.Health?.Invulnerable ?? false;
	bool InfiniteAmmo => PlayerWeapons().Any( w => w.InfiniteAmmo );

	IEnumerable<PlayerWeapon> PlayerWeapons() =>
		Player?.Components.GetAll<PlayerWeapon>( FindMode.EverythingInSelf ) ?? System.Linq.Enumerable.Empty<PlayerWeapon>();

	// ---- actions ----
	void Pause( bool value ) { if ( Director is { } d ) d.SpawningPaused = value; }
	void ToggleZombies() { if ( Director is { } d ) d.SpawnZombies = !d.SpawnZombies; }
	void ToggleBloobers() { if ( Director is { } d ) d.SpawnBloobers = !d.SpawnBloobers; }
	void ToggleSquiliens() { if ( Director is { } d ) d.SpawnSquiliens = !d.SpawnSquiliens; }
	void ToggleCrabs() { if ( Director is { } d ) d.SpawnCrabs = !d.SpawnCrabs; }
	void SpawnAlly()
	{
		foreach ( var a in Scene.GetAllComponents<SeaSpider>().Where( s => s.IsAlly ).ToList() ) a.GameObject.Destroy();
		if ( Player.IsValid() ) SeaSpider.SpawnAlly( Scene, Player );
	}
	void ToggleSpiders() { if ( Director is { } d ) d.SpawnSpiders = !d.SpawnSpiders; }
	void ToggleBossWaves() { if ( Director is { } d ) d.SpawnBossWaves = !d.SpawnBossWaves; }
	void SpawnOne( WaveDirector.EnemyKind kind ) { Director?.Spawn( kind ); }
	void KillAll() { Director?.ClearEnemies(); }
	void SkipWave() { Director?.SkipWave(); }

	void ToggleGodMode() { if ( Player?.Health is { } h ) h.Invulnerable = !h.Invulnerable; }
	void ToggleInfiniteAmmo()
	{
		var on = !InfiniteAmmo;
		foreach ( var weapon in PlayerWeapons() ) weapon.InfiniteAmmo = on;
	}
	void Heal() { if ( Player?.Health is { } h ) h.Heal( h.MaxHealth ); }
	void RefillAmmo() { foreach ( var weapon in PlayerWeapons() ) weapon.RefillAmmo(); }
	void AddPoints() { Player?.AddPoints( 1000 ); }

	string Chip( bool on ) => on ? "chip on" : "chip off";
	string Pick( bool on ) => on ? "chip on" : "chip";

	// Re-render only when something the menu shows actually changes.
	protected override int BuildHash()
	{
		var a = System.HashCode.Combine( open, Wave, Kills, Remaining, Phase, GodMode, InfiniteAmmo, Paused );
		var b = System.HashCode.Combine( Zombies, Bloobers, Squiliens, Crabs, Spiders, BossWaves,
			System.HashCode.Combine( DevFlags.FreezeEnemies, DevFlags.Noclip, DevFlags.HideHud, DevFlags.HideWeapon, DevFlags.Placing, placeKind ) );
		var c = System.HashCode.Combine( DevFlags.FreeCam, DevFlags.Fov, DevFlags.OneShot, DevFlags.ShowHitboxes, DevFlags.ShowStats, TimeScale, sunPreset, savedSpot is null );
		// The stats overlay ticks a few times a second.
		var d = DevFlags.ShowStats ? (int)(RealTime.Now * 4f) : 0;
		return System.HashCode.Combine( a, b, c, d );
	}

	// ---- hands-on tools: noclip, placing enemies at the crosshair, hiding the HUD ----
	WaveDirector.EnemyKind placeKind;
	bool noclipApplied;
	bool savedGravity = true;
	bool hudHidden;

	/// <summary> How fast noclip flies (Shift for 3x). </summary>
	const float NoclipSpeed = 450f;

	void SetNoclip( bool on )
	{
		DevFlags.Noclip = on;
		if ( Player?.Controller is { } controller && controller.IsValid() && !open )
			controller.UseInputControls = !on && !DevFlags.FreeCam;
	}

	void UpdateNoclip()
	{
		var controller = Player?.Controller;
		if ( !controller.IsValid() ) return;
		var body = controller.Body;

		if ( DevFlags.Noclip != noclipApplied )
		{
			noclipApplied = DevFlags.Noclip;
			if ( body.IsValid() )
			{
				if ( noclipApplied )
				{
					savedGravity = body.Gravity;
					body.Gravity = false;
					body.Velocity = Vector3.Zero;
				}
				else
				{
					body.Gravity = savedGravity;
					body.Velocity = Vector3.Zero;
				}
				body.MotionEnabled = !noclipApplied;   // kinematic while flying, so walls don't push back
			}
			if ( !open ) controller.UseInputControls = !noclipApplied && !DevFlags.FreeCam;
		}

		if ( !noclipApplied || open || DevFlags.FreeCam ) return;

		// Fly where you look: WASD along the view, Space up, Ctrl down, Shift faster.
		var view = controller.EyeAngles.ToRotation();
		var move = Input.AnalogMove;
		var wish = view.Forward * move.x + view.Left * move.y;
		if ( Input.Down( "Jump" ) ) wish += Vector3.Up;
		if ( Input.Down( "Duck" ) ) wish += Vector3.Down;
		if ( wish.IsNearlyZero() ) return;
		var speed = NoclipSpeed * (Input.Down( "Run" ) ? 3f : 1f);
		controller.WorldPosition += wish.Normal * speed * RealTime.Delta;
		if ( body.IsValid() ) body.Velocity = Vector3.Zero;
	}

	void StartPlacing( WaveDirector.EnemyKind kind )
	{
		placeKind = kind;
		DevFlags.Placing = true;
		SetOpen( false );
	}

	void UpdatePlacing()
	{
		if ( !DevFlags.Placing || open ) return;
		var camera = Scene.Camera;
		if ( !camera.IsValid() ) return;

		if ( Input.Pressed( "Attack2" ) )
		{
			DevFlags.Placing = false;
			return;
		}

		var from = camera.WorldPosition;
		var trace = Scene.Trace.Ray( from, from + camera.WorldRotation.Forward * 8000f )
			.WithoutTags( "player", "viewmodel", "creature", "gib", "zombie", "zombieblocker", "trigger" );
		if ( Player is { } p ) trace = trace.IgnoreGameObjectHierarchy( p.GameObject );
		var tr = trace.Run();
		if ( !tr.Hit ) return;

		DebugOverlay.Sphere( new Sphere( tr.HitPosition, 10f ), Color.Cyan );
		DebugOverlay.Line( tr.HitPosition, tr.HitPosition + Vector3.Up * 60f, Color.Cyan );

		if ( Input.Pressed( "Attack1" ) )
			Director?.SpawnAt( placeKind, tr.HitPosition + tr.Normal * 2f, from );
	}

	void UpdateHideHud()
	{
		var hide = DevFlags.HideHud;
		if ( hide == hudHidden ) return;
		hudHidden = hide;
		foreach ( var panel in Scene.GetAllComponents<PanelComponent>() )
		{
			if ( panel == this || panel.Panel is null ) continue;
			panel.Panel.Style.Display = hide ? DisplayMode.None : null;
		}
	}

	// ---- free camera: fly the view on its own while the player stays put ----
	const float FreeCamSpeed = 350f;

	void SetFreeCam( bool on )
	{
		var controller = Player?.Controller;
		if ( on )
		{
			var cam = Scene.Camera;
			DevFlags.FreeCamPosition = cam.IsValid() ? cam.WorldPosition : (controller?.WorldPosition ?? Vector3.Zero) + Vector3.Up * 64f;
			DevFlags.FreeCamAngles = controller.IsValid() ? controller.EyeAngles : (cam.IsValid() ? cam.WorldRotation.Angles() : Angles.Zero);
		}
		DevFlags.FreeCam = on;
		if ( controller.IsValid() && !open )
		{
			controller.UseInputControls = !on && !DevFlags.Noclip;
			controller.UseLookControls = !on;
		}
	}

	void UpdateFreeCam()
	{
		if ( !DevFlags.FreeCam || open ) return;
		var look = Input.AnalogLook;
		var angles = DevFlags.FreeCamAngles + look;
		angles.pitch = MathX.Clamp( angles.pitch, -89f, 89f );
		angles.roll = 0f;
		DevFlags.FreeCamAngles = angles;

		var view = angles.ToRotation();
		var move = Input.AnalogMove;
		var wish = view.Forward * move.x + view.Left * move.y;
		if ( Input.Down( "Jump" ) ) wish += Vector3.Up;
		if ( Input.Down( "Duck" ) ) wish += Vector3.Down;
		if ( wish.IsNearlyZero() ) return;
		var speed = FreeCamSpeed * (Input.Down( "Run" ) ? 3f : 1f);
		DevFlags.FreeCamPosition += wish.Normal * speed * RealTime.Delta;
	}

	// ---- time ----
	static readonly float[] TimeScales = { 0f, 0.1f, 0.25f, 0.5f, 1f };
	static readonly float[] Fovs = { 0f, 50f, 75f, 90f, 110f };
	float TimeScale => Scene.TimeScale;
	void SetTimeScale( float t ) => Scene.TimeScale = t;

	// ---- look (global stylize post-process) ----
	static readonly float[] BandCounts = { 2f, 3f, 4f, 6f };
	static readonly float[] InkLevels = { 0f, 0.5f, 0.9f };
	GlobalStylize Stylize => Scene.GetAllComponents<GlobalStylize>().FirstOrDefault();
	void SetLook( GlobalStylize.Look look ) { if ( Stylize is { } z ) z.Style = look; }

	// ---- creature skin shaders (experiment) ----
	static readonly string[] SkinFx = { "Off", "Dissolve", "Ghost", "Holo", "Iridescent" };
	string skinFx = "Off";
	readonly Dictionary<ModelRenderer, Material> skinOriginals = new();

	void SetSkinFx( string fx )
	{
		skinFx = fx;
		var path = fx switch
		{
			"Dissolve" => "materials/fx/fx_dissolve.vmat",
			"Ghost" => "materials/fx/fx_ghost.vmat",
			"Holo" => "materials/fx/fx_hologram.vmat",
			"Iridescent" => "materials/fx/fx_iridescent.vmat",
			_ => null,
		};
		var material = path is null ? null : Material.Load( path );

		// Put back whatever skins we swapped out before.
		foreach ( var (r, original) in skinOriginals )
			if ( r.IsValid() ) r.MaterialOverride = original;
		skinOriginals.Clear();
		if ( material is null ) return;

		// Creature rigs are built as their own objects, so walk the shootable parts instead of the creature component.
		foreach ( var part in Scene.GetAllComponents<CreaturePart>() )
			foreach ( var r in part.GameObject.Components.GetAll<ModelRenderer>( FindMode.EverythingInSelfAndDescendants ) )
			{
				// Only the body skins, so eyes and props keep their look.
				var current = r.MaterialOverride;
				if ( skinOriginals.ContainsKey( r ) || current is null || !(current.Name?.Contains( "materials/creature/" ) ?? false) ) continue;
				skinOriginals[r] = current;
				r.MaterialOverride = material;
			}
	}

	// ---- sun ----
	static readonly string[] SunPresets = { "Default", "Morning", "Noon", "Dusk", "Night" };
	string sunPreset = "Default";
	Rotation? sunRotation;
	Color sunColor;

	void SetSun( string preset )
	{
		var sun = Scene.GetAllComponents<DirectionalLight>().FirstOrDefault();
		if ( !sun.IsValid() ) return;
		if ( sunRotation is null )
		{
			sunRotation = sun.WorldRotation;
			sunColor = sun.LightColor;
		}
		sunPreset = preset;
		var yaw = sunRotation.Value.Angles().yaw;
		(sun.WorldRotation, sun.LightColor) = preset switch
		{
			"Morning" => (Rotation.From( 18f, yaw, 0f ), new Color( 1f, 0.82f, 0.62f ) * 2.2f),
			"Noon" => (Rotation.From( 78f, yaw, 0f ), new Color( 1f, 0.97f, 0.92f ) * 3f),
			"Dusk" => (Rotation.From( 6f, yaw + 40f, 0f ), new Color( 1f, 0.5f, 0.28f ) * 1.8f),
			"Night" => (Rotation.From( 45f, yaw, 0f ), new Color( 0.35f, 0.45f, 0.8f ) * 0.5f),
			_ => (sunRotation.Value, sunColor),
		};
	}

	// ---- enemies ----
	void ForceBoss( MC61.Mode mode )
	{
		foreach ( var boss in Scene.GetAllComponents<MC61>() )
			if ( !boss.IsDead ) boss.ForceState( mode );
	}

	void BossToTenPercent()
	{
		foreach ( var boss in Scene.GetAllComponents<MC61>() )
			if ( !boss.IsDead && boss.Components.Get<Health>() is { } h ) h.Current = h.MaxHealth * 0.1f;
	}

	void UpdateHitboxes()
	{
		if ( !DevFlags.ShowHitboxes ) return;
		foreach ( var part in Scene.GetAllComponents<CreaturePart>() )
		{
			foreach ( var c in part.Components.GetAll<Collider>() )
			{
				var t = c.WorldTransform;
				switch ( c )
				{
					case SphereCollider s:
						DebugOverlay.Sphere( new Sphere( t.PointToWorld( s.Center ), s.Radius * t.UniformScale ), Color.Yellow );
						break;
					case CapsuleCollider cap:
						var a = t.PointToWorld( cap.Start );
						var b = t.PointToWorld( cap.End );
						var r = cap.Radius * t.UniformScale;
						DebugOverlay.Sphere( new Sphere( a, r ), Color.Yellow );
						DebugOverlay.Sphere( new Sphere( b, r ), Color.Yellow );
						DebugOverlay.Line( a, b, Color.Yellow );
						break;
					case BoxCollider box:
						DebugOverlay.Box( BBox.FromPositionAndSize( box.Center, box.Scale ), Color.Yellow, 0f, t );
						break;
					default:
						DebugOverlay.Box( c.GameObject.GetBounds(), Color.Orange );
						break;
				}
			}
		}
	}

	// ---- travel ----
	(Vector3 Position, Angles Angles)? savedSpot;

	void MovePlayer( Vector3 position, Angles? angles = null )
	{
		var controller = Player?.Controller;
		if ( !controller.IsValid() ) return;
		controller.WorldPosition = position;
		if ( angles is { } a ) controller.EyeAngles = a;
		if ( controller.Body.IsValid() ) controller.Body.Velocity = Vector3.Zero;
		if ( DevFlags.FreeCam ) SetFreeCam( true );   // bring the free camera along
	}

	Vector3 Ground( Vector3 near )
	{
		var tr = Scene.Trace.Ray( near + Vector3.Up * 50f, near + Vector3.Down * 3000f )
			.WithoutTags( "player", "creature", "gib", "zombie", "zombieblocker", "trigger", "viewmodel" ).Run();
		return tr.Hit ? tr.HitPosition : near;
	}

	void TeleportToBoss()
	{
		var boss = Scene.GetAllComponents<MC61>().FirstOrDefault( b => !b.IsDead );
		if ( boss is null ) return;
		var forward = boss.WorldRotation.Forward.WithZ( 0 ).Normal;
		var spot = Ground( boss.WorldPosition.WithZ( boss.WorldPosition.z ) + forward * 260f );
		var look = Rotation.LookAt( boss.WorldPosition - (spot + Vector3.Up * 64f) ).Angles();
		MovePlayer( spot, look.WithRoll( 0f ) );
	}

	void TeleportToSpawnPoint()
	{
		var points = Scene.GetAllComponents<ZombieSpawnPoint>().ToList();
		if ( points.Count == 0 ) return;
		MovePlayer( Game.Random.FromList( points ).WorldPosition + Vector3.Up * 4f );
	}

	void SaveSpot()
	{
		if ( Player?.Controller is { } c && c.IsValid() ) savedSpot = (c.WorldPosition, c.EyeAngles);
	}

	void LoadSpot()
	{
		if ( savedSpot is { } s ) MovePlayer( s.Position, s.Angles );
	}

	void LoadScene( string path )
	{
		SetOpen( false );
		Scene.TimeScale = 1f;
		Scene.LoadFromFile( path );
	}

	// ---- stats overlay ----
	int Fps => (int)MathF.Round( 1f / MathF.Max( 0.0001f, RealTime.SmoothDelta ) );
	string FrameMs => (RealTime.SmoothDelta * 1000f).ToString( "0.0" );
	int AliveEnemies => Scene.GetAllComponents<Zombie>().Count( z => !z.IsDead ) + Scene.GetAllComponents<Bloober>().Count( c => !c.IsDead )
		+ Scene.GetAllComponents<Squilien>().Count( c => !c.IsDead ) + Scene.GetAllComponents<JunkCrab>().Count( c => !c.IsDead ) + Scene.GetAllComponents<SeaSpider>().Count( c => !c.IsDead && !c.IsAlly ) + Scene.GetAllComponents<MC61>().Count( c => !c.IsDead );
	string PlayerPos => Player?.WorldPosition is { } p ? $"{p.x:0} {p.y:0} {p.z:0}" : "";
}
