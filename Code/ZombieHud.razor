@using Sandbox;
@using Sandbox.UI;
@inherits PanelComponent

<root>
	<div class="hurt" style="opacity: @HurtOpacity"></div>
	<div class="venom" style="opacity: @VenomOpacity"></div>

	@if ( Afflictions is { } splat && splat.Drips.Count > 0 )
	{
		<div class="splatter">
			@foreach ( var drip in splat.Drips )
			{
				var age = Time.Now - drip.Born;
				var fade = MathX.Clamp( 1f - (age - 0.6f) / (PlayerAfflictions.DripLife - 0.6f), 0f, 1f );
				var pop = MathX.Clamp( age / 0.06f, 0.3f, 1f );
				var size = drip.Size * pop;
				var slide = MathF.Max( 0f, age - 0.25f ) * drip.Slide;
				var c = drip.Color;
				var rgb = $"{(int)(c.r * 255)}, {(int)(c.g * 255)}, {(int)(c.b * 255)}";
				var blob = $"radial-gradient( rgba( {rgb}, 0.92 ) 48%, rgba( {rgb}, 0 ) 64% )";
				@* The streak it leaves running down the lens. *@
				@if ( slide > 0.3f )
				{
					<div class="drip" style="left: @(drip.X)%; top: @(drip.Y)%; width: @(size * 0.28f)px; height: @(slide)%; margin-left: @(-size * 0.14f)px; opacity: @(fade * 0.55f); border-radius: 40px; background-image: linear-gradient( to bottom, rgba( @rgb, 0 ), rgba( @rgb, 0.8 ) );"></div>
				}
				<div class="drip" style="left: @(drip.X)%; top: @(drip.Y + slide)%; width: @(size)px; height: @(size * (1f + slide * 0.03f))px; margin-left: @(-size / 2)px; margin-top: @(-size / 2)px; opacity: @(fade * 0.85f); background-image: @blob;"></div>
				@* A few flecks thrown off round it. *@
				@foreach ( var fleck in Flecks( drip ) )
				{
					<div class="drip" style="left: @(drip.X)%; top: @(drip.Y)%; width: @(fleck.Size)px; height: @(fleck.Size)px; margin-left: @(fleck.X - fleck.Size / 2)px; margin-top: @(fleck.Y - fleck.Size / 2)px; opacity: @(fade * 0.8f); background-image: @blob;"></div>
				}
			}
		</div>
	}
	<div class="burn" style="opacity: @BurnOpacity"></div>
	<div class="slow" style="opacity: @SlowOpacity"></div>

	@if ( InkOpacity > 0f )
	{
		<div class="ink" style="opacity: @InkOpacity">
			@foreach ( var blot in Afflictions.Blots )
			{
				<div class="blot" style="left: @(blot.X)%; top: @(blot.Y)%; width: @(blot.Size)px; height: @(blot.Size * 0.85f)px; margin-left: @(-blot.Size / 2)px; margin-top: @(-blot.Size * 0.42f)px;"></div>
				@foreach ( var drop in Drops( blot ) )
				{
					<div class="blot" style="left: @(blot.X)%; top: @(blot.Y)%; width: @(drop.Size)px; height: @(drop.Size)px; margin-left: @(drop.X)px; margin-top: @(drop.Y)px;"></div>
				}
			}
		</div>
	}

	@if ( Movement is { } move && StaminaOpacity > 0f )
	{
		<div class="stamina @(move.TimeSinceOutOfStamina < 0.35f ? "empty" : "")" style="opacity: @StaminaOpacity">
			@for ( var i = 0; i < move.MaxStamina; i++ )
			{
				var fill = MathX.Clamp( move.Stamina - i, 0f, 1f );
				<div class="pip @(fill >= 1f ? "full" : "")"><div class="fill" style="width: @(fill * 100f)%"></div></div>
			}
		</div>
	}

	<div class="crosshair" style="transform: scale( @CrosshairScale ); opacity: @(1f - (Weapon?.AimAmount ?? 0f))">
		<div class="dot"></div>
	</div>

	@if ( HitmarkerOpacity > 0f )
	{
		<div class="hitmarker @(IsKillMarker ? "kill" : "")" style="opacity: @HitmarkerOpacity; transform: scale( @HitmarkerScale ) rotate( 45deg )">
			<div class="arm up"></div>
			<div class="arm down"></div>
			<div class="arm left"></div>
			<div class="arm right"></div>
		</div>
	}

	<div class="top">
		<div class="wave">@(Director?.OpenWorld ?? false ? "DANGER" : "WAVE") @(Director?.Wave ?? 0)</div>
		<div class="status">@StatusText</div>
	</div>

	@if ( Boss is { } boss )
	{
		<div class="boss">
			<div class="name">MC61</div>
			<div class="bar"><div class="fill" style="width: @(boss.HealthFraction * 100f)%"></div></div>
		</div>

		@if ( boss.TimeSinceLine < 2.4f && !string.IsNullOrEmpty( boss.Line ) )
		{
			<div class="speech" style="opacity: @(MathX.Clamp( (2.4f - boss.TimeSinceLine) / 0.5f, 0f, 1f )); transform: scale( @(1f + MathX.Clamp( 1f - boss.TimeSinceLine / 0.2f, 0f, 1f ) * 0.5f) ) rotate( @(MathF.Sin( Time.Now * 30f ) * 2f)deg )">@boss.Line</div>
		}
	}

	@if ( BannerOpacity > 0f )
	{
		<div class="banner @BannerClass" style="opacity: @BannerOpacity; transform: scale( @BannerScale )">
			<div class="big">@BannerTitle</div>
			<div class="small">@BannerSubtitle</div>
		</div>
	}

	<div class="kills">
		<div class="count" style="transform: scale( @KillPop )">@(Director?.Kills ?? 0)</div>
		<div class="caption">KILLS</div>
	</div>

	<div class="points @(PointsDenied ? "denied" : "")">
		<div class="value">@(Player?.Points ?? 0)</div>
		@if ( GainOpacity > 0f )
		{
			<div class="gain" style="opacity: @GainOpacity; transform: translateY( @(GainRise)px )">+@Player.LastGain</div>
		}
	</div>

	@if ( HoveredStation is { } station )
	{
		<div class="prompt @(CanAffordStation ? "" : "cant")">
			<div class="key">E</div>
			<div class="text">
				<div class="title">@station.Title  @(station.SoldOut ? "Sold out" : $"{station.CurrentCost}")</div>
				<div class="desc">@station.Description</div>
			</div>
		</div>
	}

	<div class="health @(HealthPercent <= 30 ? "low" : "") @(IsVenomed ? "venomed" : "") @(IsBurning ? "burning" : "")">
		<div class="caption">HEALTH@(StatusCaption)</div>
		<div class="bar">
			<div class="lag" style="width: @(LagPercent)%"></div>
			<div class="fill" style="width: @(HealthPercent)%"></div>
		</div>
	</div>

	<div class="ammo @(LowAmmo ? "low" : "")">
		<div class="weapon-name">@(Weapon?.DisplayName ?? "")</div>
		<div class="row">
			<div class="mag">@(Weapon?.Ammo ?? 0)</div>
			<div class="reserve">/ @(Weapon?.Reserve ?? 0)</div>
		</div>
		@if ( Weapon?.IsReloading ?? false )
		{
			<div class="reload"><div class="fill" style="width: @(ReloadPercent)%"></div></div>
		}
	</div>

	@if ( Director?.State == WaveState.GameOver )
	{
		<div class="gameover">
			<div class="title">YOU DIED</div>
			<div class="detail">@(Director.OpenWorld ? "Reached danger" : "Survived to wave") @Director.Wave with @Director.Kills kills</div>
			<div class="detail">Press JUMP to try again</div>
		</div>
	}
</root>

@code
{
	WaveDirector Director => Scene.Get<WaveDirector>();
	PlayerSurvivor Player => Scene.GetAllComponents<PlayerSurvivor>().FirstOrDefault( p => !p.IsProxy );
	PlayerWeapon Weapon => Player?.Weapon;

	float lagHealth = 100f;
	int lastKills;
	TimeSince timeSinceKillCount = 999f;

	BuyStation HoveredStation => Player?.Controller?.Hovered as BuyStation;
	bool CanAffordStation => HoveredStation is { } s && !s.SoldOut && (Player?.Points ?? 0) >= s.CurrentCost;
	bool PointsDenied => (Player?.TimeSinceDenied ?? 999f) < 0.4f;
	float GainAge => Player?.TimeSinceGain ?? 999f;
	float GainOpacity => MathX.Clamp( 1f - (GainAge - 0.5f) / 0.4f, 0f, 1f );
	float GainRise => -MathF.Min( GainAge, 0.9f ) * 30f;

	int HealthPercent => (int)MathF.Round( (Player?.Health?.Fraction ?? 0f) * 100f );
	int LagPercent => (int)MathF.Round( lagHealth );
	int ReloadPercent => (int)MathF.Round( (Weapon?.ReloadProgress ?? 0f) * 100f );
	bool LowAmmo => Weapon is not null && !Weapon.IsReloading && Weapon.Ammo <= Weapon.MagazineSize / 4;

	// Crosshair blooms out a little each shot.
	float CrosshairScale => 1f + MathX.Clamp( 1f - (Weapon?.TimeSinceShot ?? 999f) / 0.12f, 0f, 1f ) * 1.2f;

	bool IsKillMarker => (Weapon?.TimeSinceKill ?? 999f) < 0.35f;
	float HitmarkerAge => IsKillMarker ? Weapon.TimeSinceKill : (Weapon?.TimeSinceHit ?? 999f);
	float HitmarkerOpacity => MathX.Clamp( 1f - HitmarkerAge / (IsKillMarker ? 0.35f : 0.18f), 0f, 1f );
	float HitmarkerScale => (IsKillMarker ? 1.5f : 1f) * (1.3f - 0.3f * HitmarkerOpacity);

	float KillPop => 1f + MathX.Clamp( 1f - timeSinceKillCount / 0.25f, 0f, 1f ) * 0.5f;

	float HurtOpacity
	{
		get
		{
			var health = Player?.Health;
			if ( health is null ) return 0f;
			if ( health.IsDead ) return 0.6f;
			var flash = MathX.Clamp( 0.5f - health.TimeSinceDamaged, 0f, 0.5f );
			// Low health: a slow pulse at the edges of the screen.
			var low = health.Fraction < 0.3f ? (0.15f + 0.1f * MathF.Sin( Time.Now * 6f )) : 0f;
			return MathF.Max( flash, low );
		}
	}

	PlayerAfflictions Afflictions => Player?.GetComponent<PlayerAfflictions>();
	PlayerMovement Movement => Player?.GetComponent<PlayerMovement>();

	// Stamina pips show while they're refilling (or you tried to spend one you didn't have), then fade.
	float staminaShown;
	float StaminaOpacity
	{
		get
		{
			var m = Movement;
			if ( m is null ) return 0f;
			var wanted = m.Stamina < m.MaxStamina - 0.01f || m.TimeSinceOutOfStamina < 0.6f ? 1f : 0f;
			staminaShown = MathX.Approach( staminaShown, wanted, Time.Delta * (wanted > 0f ? 8f : 1.5f) );
			return staminaShown;
		}
	}

	/// <summary> Small flecks round a goo splash, the same every frame for that splash. </summary>
	static IEnumerable<(float X, float Y, float Size)> Flecks( PlayerAfflictions.ScreenDrip drip )
	{
		var r = new System.Random( (int)(drip.Born * 1000f) ^ (int)(drip.X * 37f) );
		var count = 3 + r.Next( 0, 3 );
		for ( var i = 0; i < count; i++ )
		{
			var angle = (float)r.NextDouble() * MathF.PI * 2f;
			var dist = drip.Size * (0.5f + (float)r.NextDouble() * 0.6f);
			yield return (MathF.Cos( angle ) * dist, MathF.Sin( angle ) * dist, drip.Size * (0.1f + (float)r.NextDouble() * 0.18f));
		}
	}

	// Ink fades out over its last second.
	float InkOpacity => Afflictions is { } a && a.InkLeft > 0f ? MathX.Clamp( a.InkLeft / 1f, 0f, 1f ) * 0.92f : 0f;

	/// <summary> Little splatter drops around a blot (offsets from its centre, in px), the same every frame. </summary>
	static IEnumerable<(float X, float Y, float Size)> Drops( PlayerAfflictions.Blot blot )
	{
		var r = new System.Random( blot.Seed );
		for ( var d = 0; d < 4; d++ )
		{
			var size = blot.Size * (0.15f + (float)r.NextDouble() * 0.2f);
			var angle = (float)r.NextDouble() * MathF.PI * 2f;
			var dist = blot.Size * (0.45f + (float)r.NextDouble() * 0.25f);
			yield return (MathF.Cos( angle ) * dist - size / 2f, MathF.Sin( angle ) * dist - size / 2f, size);
		}
	}
	bool IsVenomed => (Afflictions?.VenomLeft ?? 0f) > 0f;
	bool IsBurning => (Afflictions?.BurnLeft ?? 0f) > 0f;
	bool IsSlowed => (Afflictions?.SlowLeft ?? 0f) > 0f;
	string StatusCaption => (IsVenomed ? "   VENOM" : "") + (IsBurning ? "   BURNING" : "") + (IsSlowed ? "   SLOWED" : "");

	float BurnOpacity => IsBurning ? (0.3f + 0.15f * MathF.Sin( Time.Now * 11f )) * MathX.Clamp( Afflictions.BurnLeft / 0.6f, 0f, 1f ) : 0f;
	float SlowOpacity => IsSlowed ? 0.45f * MathX.Clamp( Afflictions.SlowLeft / 0.6f, 0f, 1f ) : 0f;

	/// <summary> The boss, while one is alive. </summary>
	MC61 Boss => Scene.GetAllComponents<MC61>().FirstOrDefault( b => !b.IsDead );

	// Venom: a sickly green pulse round the edges while it lasts, with a strong flash when it kicks in.
	float VenomOpacity
	{
		get
		{
			var a = Afflictions;
			if ( a is null || a.VenomLeft <= 0f ) return 0f;
			var kick = MathX.Clamp( 1f - a.TimeSinceVenomed / 0.6f, 0f, 1f ) * 0.5f;
			var pulse = 0.28f + 0.12f * MathF.Sin( Time.Now * 7f );
			return MathF.Max( kick, pulse ) * MathX.Clamp( a.VenomLeft / 0.8f, 0f, 1f );
		}
	}

	// Big centre banner for "WAVE 3" and "WAVE CLEARED".
	float BannerAge
	{
		get
		{
			var d = Director;
			if ( d is null ) return 999f;
			return MathF.Min( d.TimeSinceWaveStarted, d.TimeSinceWaveCleared );
		}
	}
	bool BannerIsStart => Director is not null && Director.TimeSinceWaveStarted < Director.TimeSinceWaveCleared;
	string BannerClass => BannerIsStart ? "start" : "cleared";
	bool FloatStart => BannerIsStart && (Director?.FloatRound ?? false);
	string BannerTitle => (Director?.OpenWorld ?? false) ? (BannerIsStart ? $"DANGER {Director?.Wave}" : "") : FloatStart ? "ANCHOR SNAPPED" : BannerIsStart ? $"WAVE {Director?.Wave}" : "WAVE CLEARED";
	string BannerSubtitle => (Director?.OpenWorld ?? false) ? "The ground ahead is getting worse" : FloatStart ? $"Wave {Director?.Wave}: you're floating. Jump to rise, crouch to sink"
		: BannerIsStart ? (Director?.BossWave ?? false ? "MC61 has entered the arena" : "They're coming") : "Catch your breath";
	float BannerOpacity => BannerAge < 0.2f ? BannerAge / 0.2f : MathX.Clamp( 1f - (BannerAge - 2f) / 0.6f, 0f, 1f );
	float BannerScale => 1f + MathX.Clamp( 1f - BannerAge / 0.25f, 0f, 1f ) * 0.6f;

	string StatusText
	{
		get
		{
			var d = Director;
			if ( d is null ) return "";
			if ( d.OpenWorld && d.State == WaveState.Fighting ) return $"{d.CellsExplored} areas explored, {d.ZombiesRemaining} enemies near";
			return d.State switch
			{
				WaveState.Intermission when d.Wave == 0 => $"Enemies incoming in {MathF.Ceiling( d.SecondsUntilNextWave )}",
				WaveState.Intermission => $"Next wave in {MathF.Ceiling( d.SecondsUntilNextWave )}",
				WaveState.Fighting => $"{d.ZombiesRemaining} enemies left",
				_ => "",
			};
		}
	}

	protected override void OnUpdate()
	{
		// The pale "lag" bar drains behind the real health bar so hits read clearly.
		var target = Player?.Health is { } h ? h.Fraction * 100f : 0f;
		lagHealth = target > lagHealth ? target : MathX.Lerp( lagHealth, target, Time.Delta * 3f );

		var kills = Director?.Kills ?? 0;
		if ( kills != lastKills )
		{
			lastKills = kills;
			timeSinceKillCount = 0f;
		}
	}

	// Rebuild every frame: most of the HUD is animated.
	protected override int BuildHash() => System.HashCode.Combine( Time.Now );
}
